# Required: use a NEW database, not Chintu's chintu_db.
DATABASE_URL=postgresql://ai_workforce_app:CHANGE_ME@127.0.0.1:5432/ai_workforce_db
PORT=4173
NODE_ENV=development

# First admin is provisioned by npm run seed. Use a strong unique password.
ADMIN_NAME=Business Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeThis-Strong-Password-2026!
BUSINESS_NAME=Northstar Growth Studio

# Optional. If absent, the app uses a deterministic rules-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp bridge: generate a random secret and use the same value in Chintu.
# Never paste this secret into frontend code or commit it to Git.
WHATSAPP_BRIDGE_TOKEN=
# Matches the MVP seed tenant. Keep this aligned with the tenant seeded in your database.
WHATSAPP_TENANT_ID=2a5e20fc-3df4-42f5-a6bc-69b6e12d3d9e
# Add only approved, customer-safe facts (products, published pricing, hours, policies). Do not add secrets or private CRM records.
WHATSAPP_KNOWLEDGE_BASE=
# Set to your publicly reachable HTTPS base URL when connecting from another device / Termux.
PUBLIC_BASE_URL=

# Optional session controls
SESSION_TTL_HOURS=8
